# Public, build-time config for the multi-user backend.
# These are the project URL and the *publishable* (anon) key — safe to ship in
# the client. The table is RLS-locked and only reachable via the service-role
# edge function, so the anon key cannot read or write learner data directly.
#
# Leave these blank to run the app in local-only mode (no cohort sync, no
# instructor dashboard) — progress still saves per-learner in the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
